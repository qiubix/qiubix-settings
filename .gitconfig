# Shared base git config. Machine-local identity and conditional work identity
# live in ~/.gitconfig.local, which is untracked and pulled in below.
[include]
	path = ~/.gitconfig.local
[merge]
	tool = kdiff3
[push]
	default = simple
[color]
	diff = auto
	status = auto
	branch = auto
	ui = true
	interactive = auto
[color "branch"]
	current = yellow reverse
	local = yellow
	remote = green
[branch]
	autosetuprebase = always
[core]
	pager = less -+F -+X -R
	editor = nvim
	excludesfile = ~/.gitignore_global
	autocrlf = input
[credential "https://github.com"]
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = !/opt/homebrew/bin/gh auth git-credential
