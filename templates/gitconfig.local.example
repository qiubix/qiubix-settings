# Machine-local git config. Run scripts/setup-git.sh --personal|--work to
# generate this file. It is intentionally untracked: it contains the identity
# (personal machine) or the default identity and path patterns used to select
# personal/work identities (work machine).
[user]
	name = Your Personal Name
	email = you@example.com

# Host-specific safe directories (added by tooling like bazel), e.g.:
# [safe]
# 	directory = /path/to/repo
