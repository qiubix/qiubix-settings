# Machine-local git config. Run scripts/setup-git.sh to generate this file.
# It is intentionally untracked: it contains personal/work identities and
# the default identity and local path patterns used to select each identity.
[user]
	name = Your Personal Name
	email = you@example.com

[includeIf "gitdir:/absolute/path/to/work/**"]
	path = ~/.gitconfig.work

# Host-specific safe directories (added by tooling like bazel), e.g.:
# [safe]
# 	directory = /path/to/repo
